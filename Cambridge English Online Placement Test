    <!-- JavaScript Data and Logic -->
    <script>
        const questions = [
            // Tier 1: Intermediate (B1) — Questions 1 to 7
            {
                id: 1,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Present Perfect Simple vs. Past Simple",
                text: "I ___ to Italy three times, but my last trip there ___ two years ago.",
                options: [
                    "A) went / has been",
                    "B) have been / was",
                    "C) have gone / was",
                    "D) was / had been"
                ],
                correct: 1, // Index of B
                explanation: "Present perfect simple (have been) is used to describe life experiences at an unspecified past time, whereas the past simple (was) must be used when a specific finished time expression ('two years ago') is mentioned."
            },
            {
                id: 2,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Past Simple vs. Past Continuous",
                text: "While I ___ down the street, I suddenly ___ an old school friend.",
                options: [
                    "A) walked / was meeting",
                    "B) was walking / met",
                    "C) used to walk / met",
                    "D) had walked / was meeting"
                ],
                correct: 1,
                explanation: "The past continuous (was walking) describes a background action in progress in the past, while the past simple (met) denotes a shorter event that interrupted it."
            },
            {
                id: 3,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Present Perfect Simple vs. Continuous",
                text: "Sarah looks exhausted because she ___ the living room all morning, though she ___ only two walls so far.",
                options: [
                    "A) painted / has been painting",
                    "B) has been painting / has painted",
                    "C) paints / painted",
                    "D) was painting / painted"
                ],
                correct: 1,
                explanation: "The present perfect continuous (has been painting) focuses on duration and effort, whereas the present perfect simple (has painted) emphasizes the completed quantity."
            },
            {
                id: 4,
                tier: "Tier 1: Intermediate (B1)",
                title: "Vocabulary: Basic Phrasal Verbs",
                text: "Before we move into the new flat, we need to ___ it ___ with a fresh coat of paint.",
                options: [
                    "A) wear / out",
                    "B) do / up",
                    "C) clear / up",
                    "D) get / on"
                ],
                correct: 1,
                explanation: "'Do up' is a standard phrasal verb meaning to repair, redecorate, or improve a building or room."
            },
            {
                id: 5,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Conditionals & Connectors — unless vs. if",
                text: "You shouldn't take the motorway during peak hours ___ you are willing to get stuck in heavy traffic.",
                options: [
                    "A) in case",
                    "B) if",
                    "C) unless",
                    "D) although"
                ],
                correct: 2,
                explanation: "'Unless' means 'except if' or 'if not'. The sentence means 'don't take the motorway except if you are willing...'"
            },
            {
                id: 6,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Past Ability — could vs. was able to",
                text: "Although the storm was severe, the rescue team ___ reach the stranded hikers before nightfall.",
                options: [
                    "A) could",
                    "B) was able to",
                    "C) could have",
                    "D) might"
                ],
                correct: 1,
                explanation: "Cambridge grammar rules state that succeeding in a specific, difficult past occasion requires 'was/were able to' or 'managed to'."
            },
            {
                id: 7,
                tier: "Tier 1: Intermediate (B1)",
                title: "Grammar: Connectors of Precaution — in case",
                text: "Please take a waterproof jacket with you ___ it starts raining while you are on the mountain trail.",
                options: [
                    "A) if",
                    "B) in case",
                    "C) unless",
                    "D) even though"
                ],
                correct: 1,
                explanation: "'In case' is used to talk about doing something as a precaution before a potential future event occurs."
            },

            // Tier 2: Upper-Intermediate (B2) — Questions 8 to 16
            {
                id: 8,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Grammar: Passive Voice with Reporting Verbs",
                text: "The new eco-friendly policy is thought ___ by the board members during yesterday's meeting.",
                options: [
                    "A) to approve",
                    "B) to be approving",
                    "C) to have been approved",
                    "D) having been approved"
                ],
                correct: 2,
                explanation: "When reporting past events using passive structures, a past action requires the perfect passive infinitive (to have been + past participle)."
            },
            {
                id: 9,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Grammar: Causative Have and Get",
                text: "Instead of repairing the damaged roof himself, Mr. Davis decided to ___ by a professional contractor.",
                options: [
                    "A) have it fixed",
                    "B) fix it",
                    "C) get fixed it",
                    "D) have fixed it"
                ],
                correct: 0,
                explanation: "The causative structure (have/get + object + past participle) is used when arranging for a professional to perform a task."
            },
            {
                id: 10,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Grammar: Relative Clauses — Possession",
                text: "Dr. Aris, ___ research on marine biology has won international awards, will deliver the keynote address.",
                options: [
                    "A) who",
                    "B) whom",
                    "C) whose",
                    "D) which"
                ],
                correct: 2,
                explanation: "'Whose' is the relative pronoun used to indicate possession for people or things in relative clauses ('his research -> whose research')."
            },
            {
                id: 11,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Grammar: Reporting Verbs & Verb Patterns",
                text: "The project manager strongly suggested ___ a short break before finalizing the quarterly report.",
                options: [
                    "A) us to take",
                    "B) taking",
                    "C) to take",
                    "D) that we to take"
                ],
                correct: 1,
                explanation: "Cambridge exam traps frequently test 'suggest', which must be followed by verb + -ing, a noun phrase, or that + clause (never object + to-infinitive)."
            },
            {
                id: 12,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Grammar & Prepositions: Verb + Preposition Structures",
                text: "The security officer accused the stranger ___ trying to enter the restricted research facility without clearance.",
                options: [
                    "A) for",
                    "B) to",
                    "C) of",
                    "D) about"
                ],
                correct: 2,
                explanation: "'Accuse' strictly collocates with the preposition 'of' + verb -ing (accuse somebody of doing something)."
            },
            {
                id: 13,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Vocabulary: Upper-Intermediate Phrasal Verbs",
                text: "After reviewing several design proposals, the creative team managed to ___ an innovative marketing concept.",
                options: [
                    "A) come up with",
                    "B) live up to",
                    "C) get over",
                    "D) look down on"
                ],
                correct: 0,
                explanation: "'Come up with' means to think of, produce, or suggest an idea or plan."
            },
            {
                id: 14,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Word Formation: Negative Prefixes",
                text: "Leaving confidential documents unattended on your desk is highly ___ and breaches office security protocols.",
                options: [
                    "A) unresponsible",
                    "B) disresponsible",
                    "C) irresponsible",
                    "D) nonresponsible"
                ],
                correct: 2,
                explanation: "In Cambridge Word Formation, adjectives starting with r- form their negative opposite using the prefix ir- (responsible -> irresponsible)."
            },
            {
                id: 15,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Word Formation: Suffix Traps & Noun Derivation",
                text: "The sudden ___ of the new flight route caused considerable inconvenience to hundreds of travellers.",
                options: [
                    "A) cancelation",
                    "B) cancelling",
                    "C) cancellation",
                    "D) cancelment"
                ],
                correct: 2,
                explanation: "Forming nominalised nouns from verbs ending in -l in British English requires doubling the consonant and adding -ation (cancel -> cancellation)."
            },
            {
                id: 16,
                tier: "Tier 2: Upper-Intermediate (B2)",
                title: "Vocabulary Traps: Countable vs. Uncountable Nouns",
                text: "She was offered a temporary ___ at the publisher's head office, which will give her valuable professional experience.",
                options: [
                    "A) work",
                    "B) job",
                    "C) occupation",
                    "D) employment"
                ],
                correct: 1,
                explanation: "'Job' is a countable noun taking the indefinite article 'a'. 'Work' and 'employment' are uncountable and cannot follow 'a'."
            },

            // Tier 3: Advanced / Proficient (C1–C2) — Questions 17 to 25
            {
                id: 17,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Grammar: Inversion with Negative Adverbials",
                text: "Little ___ that the complex financial agreement was about to be cancelled by the board.",
                options: [
                    "A) did the director suspect",
                    "B) the director suspected",
                    "C) had the director suspected",
                    "D) was the director suspecting"
                ],
                correct: 0,
                explanation: "When negative or limiting adverbials ('Little', 'Seldom') are placed at the beginning of a clause, subject-auxiliary inversion is required (Little + did + subject + verb)."
            },
            {
                id: 18,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Grammar: Mixed Conditionals",
                text: "If the lead engineer ___ the structural calculations last month, the bridge ___ open to traffic today.",
                options: [
                    "A) didn't complete / wouldn't be",
                    "B) hadn't completed / wouldn't be",
                    "C) hadn't completed / wouldn't have been",
                    "D) wouldn't complete / isn't"
                ],
                correct: 1,
                explanation: "This is a mixed conditional combining a past unreal condition (if + past perfect) with a present result (would + base infinitive indicated by 'today')."
            },
            {
                id: 19,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Structures: Cleft Sentences for Emphasis",
                text: "It was not until the comprehensive audit was completed ___ the accounting department discovered the missing funds.",
                options: [
                    "A) when",
                    "B) that",
                    "C) which",
                    "D) where"
                ],
                correct: 1,
                explanation: "In formal English, It-cleft sentences designed to emphasize a time clause follow the structure: 'It was not until [clause] THAT [main clause]'."
            },
            {
                id: 20,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Grammar: Participle Clauses",
                text: "___ the historical evidence thoroughly, the research committee published a groundbreaking report.",
                options: [
                    "A) Having examined",
                    "B) Examined",
                    "C) Being examined",
                    "D) To examine"
                ],
                correct: 0,
                explanation: "A perfect participle clause (Having + past participle) is required to emphasize that the action of examining was completed before publication."
            },
            {
                id: 21,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Vocabulary: Advanced Collocations",
                text: "With only a few minutes remaining before the deadline, there is a very ___ chance that the proposal will be accepted.",
                options: [
                    "A) narrow",
                    "B) slim",
                    "C) thin",
                    "D) light"
                ],
                correct: 1,
                explanation: "In C1/C2 Cambridge English, 'slim chance' (or slight possibility) is a fixed adjective-noun collocation."
            },
            {
                id: 22,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Idiomatic Expressions",
                text: "When the unexpected news of the corporate merger was announced, the entire department was completely ___.",
                options: [
                    "A) taken aback",
                    "B) brought down",
                    "C) put out",
                    "D) turned over"
                ],
                correct: 0,
                explanation: "The advanced idiom 'taken aback' means to be deeply surprised, shocked, or disarranged by unexpected news."
            },
            {
                id: 23,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Formal Style: Subjunctive Structures",
                text: "The chairperson insisted that every member of the committee ___ present at the emergency briefing.",
                options: [
                    "A) is",
                    "B) be",
                    "C) will be",
                    "D) would be"
                ],
                correct: 1,
                explanation: "Formal English mandates the present subjunctive (bare infinitive: be) after verbs of demand or insistence (insist, demand, recommend + that + subject + bare verb)."
            },
            {
                id: 24,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Grammar: Verb + Infinitive vs. -ing with Meaning Shift",
                text: "I deeply regret ___ you that your application for the senior research fellowship has been unsuccessful.",
                options: [
                    "A) informing",
                    "B) to inform",
                    "C) having informed",
                    "D) to have informed"
                ],
                correct: 1,
                explanation: "'Regret + to inform / tell / say' is a formal structure used to announce bad news in the present moment."
            },
            {
                id: 25,
                tier: "Tier 3: Advanced / Proficient (C1–C2)",
                title: "Advanced Inversion & Time Connectors",
                text: "Hardly ___ the presentation begun ___ the projector broke down unexpectedly.",
                options: [
                    "A) was / than",
                    "B) had / when",
                    "C) did / when",
                    "D) has / than"
                ],
                correct: 1,
                explanation: "The paired inverted structure for immediate past sequences is 'Hardly + HAD + subject + past participle ... WHEN ...'."
