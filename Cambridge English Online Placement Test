        ];

        let currentIndex = 0;
        let userAnswers = new Array(questions.length).fill(null);

        function startTest() {
            document.getElementById('view-welcome').classList.add('hidden');
            document.getElementById('view-quiz').classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            const q = questions[currentIndex];
            document.getElementById('current-q-num').innerText = currentIndex + 1;
            document.getElementById('tier-badge').innerText = q.tier;
            document.getElementById('question-title').innerText = q.title;
            document.getElementById('question-text').innerText = q.text;

            // Update Progress bar
            const progressPercent = ((currentIndex + 1) / questions.length) * 100;
            document.getElementById('progress-bar').style.width = progressPercent + '%';

            // Render options
            const container = document.getElementById('options-container');
            container.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const isSelected = userAnswers[currentIndex] === idx;
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-xl border transition-all font-medium text-sm sm:text-base flex items-center justify-between ${
                    isSelected 
                        ? 'border-brand-500 bg-brand-50 text-brand-900 shadow-sm' 
                        : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-700'
                }`;
                
                btn.innerHTML = `
                    <span>${opt}</span>
                    <span class="w-5 h-5 rounded-full border flex items-center justify-center text-xs ${isSelected ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300'}">
                        ${isSelected ? '✓' : ''}
                    </span>
                `;
                btn.onclick = () => selectOption(idx);
                container.appendChild(btn);
            });

            // Update Nav Buttons
            document.getElementById('prev-btn').disabled = currentIndex === 0;
            const nextBtn = document.getElementById('next-btn');
            if (currentIndex === questions.length - 1) {
                nextBtn.innerText = "Finish & View Score →";
            } else {
                nextBtn.innerText = "Next Question →";
            }
            nextBtn.disabled = userAnswers[currentIndex] === null;
        }

        function selectOption(idx) {
            userAnswers[currentIndex] = idx;
            loadQuestion();
            document.getElementById('next-btn').disabled = false;
        }

        function prevQuestion() {
            if (currentIndex > 0) {
                currentIndex--;
                loadQuestion();
            }
        }

        function nextQuestion() {
            if (currentIndex < questions.length - 1) {
                currentIndex++;
                loadQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            document.getElementById('view-quiz').classList.add('hidden');
            document.getElementById('view-results').classList.remove('hidden');

            let score = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questions[idx].correct) score++;
            });

            document.getElementById('score-display').innerText = score;

            // CEFR Mapping
            let cefr = "";
            let badgeClass = "";
            let desc = "";
            let course = "";
            let focus = "";

            if (score <= 6) {
                cefr = "A2 / Below B1 (Elementary)";
                badgeClass = "bg-amber-600 text-white";
                desc = "The learner struggles with core tense contrasts, basic phrasal verbs, and simple connectors.";
                course = "Complete Preliminary (B1)";
                focus = "Focus on fundamental tenses and essential vocabulary build-up.";
            } else if (score <= 13) {
                cefr = "B1 (Intermediate)";
                badgeClass = "bg-blue-600 text-white";
                desc = "Demonstrates control over basic grammar and tenses, but struggles with passive structures, complex verb patterns, and prepositions.";
                course = "Complete First (B2)";
                focus = "Focus on upper-intermediate grammar, relative clauses, and word formation.";
            } else if (score <= 19) {
                cefr = "B2 (Upper-Intermediate)";
                badgeClass = "bg-brand-600 text-white";
                desc = "Strong command of core and advanced grammar. Errors occur mainly in high-level inversion, mixed conditionals, and subtle collocations.";
                course = "Complete Advanced (C1)";
                focus = "Focus on formal stylistic nuances, inversions, and advanced idioms.";
            } else {
                cefr = "C1 – C2 (Advanced / Proficient)";
                badgeClass = "bg-purple-700 text-white";
                desc = "Exceptional mastery of complex grammatical structures, inversion, subjunctive forms, subtle collocations, and idiomatic expressions.";
                course = "C1 Advanced / C2 Proficiency Exam Preparation";
                focus = "Polish writing style, academic register, and absolute linguistic precision.";
            }

            const badgeEl = document.getElementById('cefr-badge');
            badgeEl.innerText = cefr;
            badgeEl.className = `inline-block px-4 py-1.5 font-bold text-sm rounded-full shadow-sm mb-3 ${badgeClass}`;

            document.getElementById('level-desc-summary').innerText = desc;
            document.getElementById('recommended-course').innerText = course;
            document.getElementById('recommended-focus').innerText = focus;

            buildReviewList();
        }

        function buildReviewList() {
            const listContainer = document.getElementById('review-questions-list');
            listContainer.innerHTML = '';

            questions.forEach((q, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === q.correct;
                const userChoiceText = userAns !== null ? q.options[userAns] : "Not answered";
                const correctChoiceText = q.options[q.correct];

                const item = document.createElement('div');
                item.className = `p-5 rounded-xl border ${isCorrect ? 'bg-emerald-50/50 border-emerald-200' : 'bg-rose-50/50 border-rose-200'}`;
                
                item.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Question ${idx + 1} • ${q.tier}</span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold ${isCorrect ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                            ${isCorrect ? 'Correct ✓' : 'Incorrect ✗'}
                        </span>
                    </div>
                    <p class="font-semibold text-slate-900 mb-3">${q.text}</p>
                    <div class="text-xs space-y-1 mb-3">
                        <div class="text-slate-600"><span class="font-semibold">Your Answer:</span> <span class="${isCorrect ? 'text-emerald-700 font-bold' : 'text-rose-700 font-bold'}">${userChoiceText}</span></div>
                        ${!isCorrect ? `<div class="text-slate-600"><span class="font-semibold">Correct Answer:</span> <span class="text-emerald-700 font-bold">${correctChoiceText}</span></div>` : ''}
                    </div>
                    <div class="bg-white/80 p-3 rounded-lg border border-slate-200 text-xs text-slate-700 leading-relaxed">
                        <span class="font-bold text-slate-900">Explanation:</span> ${q.explanation}
                    </div>
                `;
                listContainer.appendChild(item);
            });
        }

        function toggleReviewMode() {
            const reviewSec = document.getElementById('review-section');
            reviewSec.classList.toggle('hidden');
            reviewSec.scrollIntoView({ behavior: 'smooth' });
        }

        function restartTest() {
            currentIndex = 0;
            userAnswers = new Array(questions.length).fill(null);
            document.getElementById('view-results').classList.add('hidden');
            document.getElementById('review-section').classList.add('hidden');
            document.getElementById('view-welcome').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function downloadHTMLCode() {
            const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
            const blob = new Blob([htmlContent], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'placement-test.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
</body>
</html>
